{
  "name": "sprintboard",
  "version": "0.1.0",
  "description": "Assigns backlog tasks to team members; no member over 8 story points.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "mcp": "node --env-file-if-exists=.env src/mcp/server.js",
    "agent": "node --env-file-if-exists=.env src/agent/cli.js",
    "test": "node --test",
    "test:live": "node --env-file-if-exists=.env --test tests/live.test.js",
    "eval": "node --env-file-if-exists=.env evals/run.js"
  }
}
