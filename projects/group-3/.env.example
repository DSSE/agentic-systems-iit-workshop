# Copy to .env. The agent works with ANY OpenAI-compatible model.
PORT=3000
PROMPT_VERSION=v2

# Offline test model (no key, no internet): set LLM_PROVIDER=mock when needed.

# --- Real model: set LLM_PROVIDER=openai-compatible and configure one provider ---
# OpenRouter + xAI Grok (create a key at https://openrouter.ai/settings/keys):
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key
LLM_MODEL=x-ai/grok-4.7
LLM_MAX_TOKENS=2048
#
# Local Ollama (no API key; use a locally installed model that supports tool calling):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your-key
# LLM_MODEL=<your-installed-tool-calling-model>
