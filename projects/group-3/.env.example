# Copy to .env. The agents work with ANY OpenAI-compatible model.
PORT=3000
PROMPT_VERSION=v2

# Offline test model (no key, no internet). Good for first run and for tests.
LLM_PROVIDER=mock

# --- Real model: delete LLM_PROVIDER=mock above and fill ONE of these ---
# Ollama (local, no key):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b
#
# Google Gemini (free key from Google AI Studio):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY_PLANNER=your-planner-key
# GEMINI_API_KEY_REVIEWER=your-reviewer-key (optional; otherwise both roles share a key)
# LLM_MODEL=gemini-3.5-flash-lite
#
# Groq (free key):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (use models ending in :free):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
