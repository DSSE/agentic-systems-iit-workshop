# CampusDesk API configuration. Copy to .env and fill in real values;
# never commit the real file.

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Optional override for the private local account directory.
# Defaults to server/.local; never commit accounts or generated passwords.
# CAMPUSDESK_AUTH_DIR=

# Chat agent: Gemini through its compatible chat-completions endpoint.
# Put your key in LLM_API_KEY (or GEMINI_API_KEY); the browser never receives it.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# CLI / MCP bridge: use a student account from .local/demo-accounts.txt.
# These are optional for UI-only use. Do not put staff credentials into agents.
CAMPUSDESK_API_URL=http://localhost:4000
CAMPUSDESK_EMAIL=
CAMPUSDESK_PASSWORD=
