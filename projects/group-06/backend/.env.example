# Copy to .env, then supply all three values to connect your model.
# Keep the key in this backend file. Never use NEXT_PUBLIC_ for secrets.
# The provider must support chat completions and function/tool calling.
# Examples of base URLs (choose the provider for your own key):
# Groq:       https://api.groq.com/openai/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1 (API key may be blank)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
