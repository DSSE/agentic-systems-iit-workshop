# Server
PORT=3000

# LLM (any OpenAI-compatible API). Copy this file to .env and fill in.
# Never put a real key in this file: it is committed. Keys go in .env only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=

# Prompt version for the agent (see src/prompts.js)
PROMPT_VERSION=v1
