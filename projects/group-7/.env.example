# Copy to .env. Real environment variables win over this file.

# Any OpenAI-compatible API. Default: local Ollama (no key, works offline).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Empty + Ollama = auto-pick an installed model that supports tool calling.
# Examples: qwen2.5:7b, qwen3:8b, llama3.1:8b
LLM_MODEL=

# Other free options (set LLM_MODEL too):
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                             LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                               LLM_MODEL=<a model ending in :free>

# Prompt version for the agent: v1 (baseline) or v2 (hardened, default)
PROMPT_VERSION=v2

# Web app port
PORT=3000

# Harness guardrails. "off" only for eval comparisons; the cap is enforced either way.
CLUBOPS_GUARDRAILS=on
CLUBOPS_MAX_STEPS=8

# 1 = show MCP server logs
CLUBOPS_DEBUG=
