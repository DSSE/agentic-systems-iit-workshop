{
  "permissions": {
    "allow": [
      "Bash(npm run check:harness)",
      "Bash(npm.cmd run check:harness)",
      "Bash(npm test)",
      "Bash(npm start)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
