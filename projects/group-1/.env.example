# Copy to .env and fill in. Never commit .env.
# The chat agent uses any OpenAI-compatible endpoint.

# Group 1 uses Google Gemini (free key from https://aistudio.google.com/apikey).
# Pick a current Flash model from AI Studio's model list for LLM_MODEL, e.g. gemini-2.5-flash.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# The free tier allows only ~20 requests/day per model. When one model's daily quota runs out,
# the chat moves on to these, in order (each has its own quota).
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview

# Other options:
#   Ollama:     http://localhost:11434/v1  (no key needed)
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1  (only models ending in :free are free)

# Optional: have the chat agent use a separately running MCP server
# (python -m app.mcp_server --http) instead of the in-process one.
# MCP_URL=http://127.0.0.1:8001/mcp
